# Copy this file to .env and fill in your key. .env is gitignored.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any model available to your key that supports tool calling.
# "gemini-flash-latest" is an alias that always points at the current fast model.
GEMINI_MODEL=gemini-flash-latest
